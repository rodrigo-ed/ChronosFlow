{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "UserTask": {
      "title": "UserTask",
      "description": "Daily prioritized tasks with start and end times",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "dueDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "estimatedMinutes": { "type": "number" },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string" },
        "goalId": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "userId", "title", "priority", "dueDate"]
    },
    "UserGoal": {
      "title": "UserGoal",
      "description": "Personal goals linked to daily routine",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string" },
        "color": { "type": "string" },
        "targetDate": { "type": "string" },
        "targetValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "unit": { "type": "string" },
        "progress": { "type": "number" }
      },
      "required": ["id", "userId", "title", "targetValue", "unit"]
    },
    "UserEvent": {
      "title": "UserEvent",
      "description": "Calendar events including recurring multi-day agendas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "startDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endDate": { "type": "string" },
        "endTime": { "type": "string" },
        "isAllDay": { "type": "boolean" },
        "color": { "type": "string" },
        "location": { "type": "string" },
        "relatedGoalId": { "type": "string" }
      },
      "required": ["id", "userId", "title", "startDate"]
    },
    "UserBook": {
      "title": "UserBook",
      "description": "Reading tracking with daily goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "author": { "type": "string", "maxLength": 150 },
        "totalPages": { "type": "number" },
        "currentPage": { "type": "number" },
        "dailyGoalMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["reading", "completed", "want_to_read"] },
        "lastReadDate": { "type": "string" }
      },
      "required": ["id", "userId", "title", "totalPages", "status"]
    },
    "UserWorkout": {
      "title": "UserWorkout",
      "description": "Health and physical activities tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["corrida", "ciclismo", "academia", "funcional", "outro"] },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "distanceKm": { "type": "number" },
        "intensity": { "type": "string", "enum": ["leve", "moderada", "intensa"] }
      },
      "required": ["id", "userId", "type", "date", "startTime", "durationMinutes"]
    },
    "UserHoliday": {
      "title": "UserHoliday",
      "description": "Custom municipal and regional holidays",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["municipal", "estadual", "nacional"] }
      },
      "required": ["id", "userId", "name", "date", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profile information for authenticated user"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/UserTask" },
      "description": "User daily tasks"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/UserGoal" },
      "description": "User personal goals"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/UserEvent" },
      "description": "User calendar events"
    },
    "/users/{userId}/books/{bookId}": {
      "schema": { "$ref": "#/entities/UserBook" },
      "description": "User books reading log"
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": { "$ref": "#/entities/UserWorkout" },
      "description": "User workouts and health activities"
    },
    "/users/{userId}/holidays/{holidayId}": {
      "schema": { "$ref": "#/entities/UserHoliday" },
      "description": "User custom municipal holidays"
    }
  }
}
