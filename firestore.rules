rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) && isValidId(taskId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId) && isValidId(goalId);
      }

      match /events/{eventId} {
        allow read, write: if isOwner(userId) && isValidId(eventId);
      }

      match /books/{bookId} {
        allow read, write: if isOwner(userId) && isValidId(bookId);
      }

      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId) && isValidId(workoutId);
      }

      match /holidays/{holidayId} {
        allow read, write: if isOwner(userId) && isValidId(holidayId);
      }
    }
  }
}
